# Environment Mode (production or development)
ENVIRONMENT=production

# Database Configuration (PostgreSQL for Production, SQLite for Local Testing)
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=foodsafe_db
DATABASE_URL=postgresql+psycopg://your_db_username:your_secure_db_password@your_db_host:5432/foodsafe_db

# Security & JWT Authentication
SECRET_KEY=change_me_to_a_random_32_character_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Configuration
VITE_API_URL=http://localhost:8000/api
